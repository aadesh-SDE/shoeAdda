<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only. All app styling is done in Compose with Material 3.
         It extends AppCompat because MainActivity is an AppCompatActivity (needed for per-app language). -->
    <style name="Theme.ShoeAdda" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!-- Shown by the system while the app starts: cocoa background and the sneaker logo. -->
    <style name="Theme.ShoeAdda.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ShoeAdda</item>
    </style>
</resources>
