# Let Git normalise line endings so Windows and other systems agree
* text=auto

# Files that must keep specific line endings
*.sh text eol=lf
gradlew text eol=lf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff2 binary
*.jar binary
